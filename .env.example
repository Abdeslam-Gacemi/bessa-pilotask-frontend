# Laravel API base URL (no trailing slash). On a phone, use the machine's LAN IP.
VITE_API_URL=http://192.168.3.131:8000/api

# Firebase web app (browser push). Leave empty to keep in-app notifications only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
